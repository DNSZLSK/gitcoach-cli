{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vitest/globals", "node"]
  },
  "include": ["./**/*", "../src/**/*"]
}
